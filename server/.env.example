# انسخ الملف إلى .env ولا ترفعه أبداً إلى GitHub
NODE_ENV=development
PORT=4000
# الأصول المسموح لها بطلب الـ API (افصل بفاصلة)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
PUBLIC_SITE_URL=http://localhost:5173

# المورّد: mock (بيانات تجريبية) أو tbo
SUPPLIER=mock
TBO_BASE_URL=http://api.tbotechnology.in/TBOHolidays_HotelAPI
TBO_USERNAME=
TBO_PASSWORD=
DEFAULT_MARKUP_PCT=8

# MyFatoorah — مفتاح الاختبار من لوحة MyFatoorah
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_API_KEY=

# قاعدة البيانات (المرحلة القادمة)
DATABASE_URL=postgres://nuzul:CHANGE_ME@localhost:5432/nuzul
REDIS_URL=redis://localhost:6379
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
